# Optional. The app already falls back to the public Supabase URL and
# publishable key in src/supabase.js, so you only need this to point the app
# at a different Supabase project.
# The publishable key is public by design. NEVER put the secret/service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
